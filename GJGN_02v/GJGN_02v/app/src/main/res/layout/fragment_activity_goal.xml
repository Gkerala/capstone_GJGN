<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ──────────────── 활동량 선택 ──────────────── -->
        <TextView
            android:id="@+id/tvActivityTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="활동량을 선택하세요"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <RadioGroup
            android:id="@+id/rgActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbActivity1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="① 거의 움직이지 않음" />

            <RadioButton
                android:id="@+id/rbActivity2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="② 일주일에 5시간 이상 걷는다" />

            <RadioButton
                android:id="@+id/rbActivity3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="③ 주 1회 이상 운동한다" />

            <RadioButton
                android:id="@+id/rbActivity4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="④ 주 3회 이상 운동한다" />

            <RadioButton
                android:id="@+id/rbActivity5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⑤ 매일 운동한다" />
        </RadioGroup>

        <!-- ──────────────── 목표 선택 ──────────────── -->

        <TextView
            android:id="@+id/tvGoalTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="목표를 선택하세요"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"/>

        <RadioGroup
            android:id="@+id/rgGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbGoalLose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="체중 감량" />

            <RadioButton
                android:id="@+id/rbGoalMaintain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="체중 유지" />

            <RadioButton
                android:id="@+id/rbGoalGain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="체중 증가" />
        </RadioGroup>

        <!-- ──────────────── 다음 버튼 ──────────────── -->
        <Button
            android:id="@+id/btnNextActivityGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="다음"
            android:layout_marginTop="30dp"
            android:backgroundTint="@color/purple_500"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>
